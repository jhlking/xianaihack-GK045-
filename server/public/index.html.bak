<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>万物改造工坊 WonderForge</title>
<style>
html, body, #root { margin: 0; height: 100%; background: #0b0d12; }
.wf-demos{--d-bg: #fbf7f1;--d-ink: #4c4238;--d-ink-soft: #6d6156;--d-muted: #9c8f81;--d-line: rgba(140, 116, 95, .16);--d-rose: #d98e96;--d-rose-deep: #b96e78;--d-amber: #d8a76a;--d-serif: "Songti SC", "STSong", "SimSun", "Source Han Serif SC", "Noto Serif SC", serif;--d-kai: "Kaiti SC", "STKaiti", "KaiTi", "Songti SC", "SimSun", serif;min-height:100vh;background:var(--d-bg);color:var(--d-ink);position:relative;overflow-x:clip;font-family:PingFang SC,Microsoft YaHei,system-ui,sans-serif;-webkit-font-smoothing:antialiased}.wf-demos ::selection{background:#f0c4b2b3;color:#6b4a3a}.wf-demos:before{content:"";position:fixed;top:0;right:0;bottom:0;left:0;pointer-events:none;background:radial-gradient(640px 440px at 6% -4%,rgba(246,200,180,.34),transparent 66%),radial-gradient(560px 430px at 97% 14%,rgba(197,226,211,.38),transparent 66%),radial-gradient(720px 540px at 52% 116%,rgba(206,215,241,.4),transparent 66%)}.wf-orb{position:fixed;border-radius:50%;filter:blur(64px);pointer-events:none;z-index:0}.wf-orb.o1{width:260px;height:260px;left:-70px;top:16%;background:#f4c5b480;animation:wf-drift-a 19s ease-in-out infinite alternate}.wf-orb.o2{width:220px;height:220px;right:-60px;top:44%;background:#c8e5d580;animation:wf-drift-b 23s ease-in-out infinite alternate}.wf-orb.o3{width:300px;height:300px;left:38%;bottom:-120px;background:#d2daf280;animation:wf-drift-a 26s ease-in-out infinite alternate-reverse}@keyframes wf-drift-a{0%{transform:translateZ(0) scale(1)}to{transform:translate3d(36px,-30px,0) scale(1.12)}}@keyframes wf-drift-b{0%{transform:translateZ(0) scale(1)}to{transform:translate3d(-30px,26px,0) scale(1.08)}}.wf-demos .topbar{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;padding:15px 30px;border-bottom:1px solid var(--d-line);background:#fbf7f1cc;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}.wf-demos .brand{font-weight:700;letter-spacing:2px;color:var(--d-ink);font-size:15px}.wf-demos .brand .glow{margin-left:6px;font-size:13px;font-weight:600;letter-spacing:1px;text-shadow:none;background:linear-gradient(120deg,var(--d-rose-deep),var(--d-amber));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:var(--d-rose-deep)}.wf-demos .nav a{position:relative;margin-left:24px;font-size:14px;letter-spacing:1px;color:var(--d-muted);transition:color .2s ease}.wf-demos .nav a:after{content:"";position:absolute;left:0;right:100%;bottom:-6px;height:2px;border-radius:2px;background:linear-gradient(90deg,var(--d-rose),var(--d-amber));transition:right .28s ease}.wf-demos .nav a:hover{color:var(--d-ink)}.wf-demos .nav a:hover:after{right:0}.wf-demos .nav a.active{color:var(--d-rose-deep);font-weight:600}.wf-demos .nav a.active:after{right:0}.wf-body{position:relative;z-index:1;max-width:1080px;margin:0 auto;padding:0 28px 40px}.wf-hero{position:relative;text-align:center;padding:64px 0 34px}.wf-hero:before{content:"";position:absolute;left:50%;top:6%;width:560px;height:560px;transform:translate(-50%);border-radius:50%;background:radial-gradient(circle,#fff2e2f2,#fff2e200 68%);pointer-events:none}.wf-eyebrow{position:relative;display:inline-flex;align-items:center;gap:9px;padding:7px 18px;border-radius:999px;background:#ffffffa8;border:1px solid rgba(255,255,255,.95);box-shadow:0 4px 14px #b48c781f;color:var(--d-rose-deep);font-size:13px;letter-spacing:3px}.wf-eyebrow:before,.wf-eyebrow:after{content:"";width:5px;height:5px;border-radius:50%;background:linear-gradient(135deg,var(--d-rose),var(--d-amber))}.wf-line{position:relative;margin:28px 0 0;font-family:var(--d-serif);font-size:clamp(25px,4.2vw,42px);font-weight:700;line-height:1.9;letter-spacing:2px;color:var(--d-ink);-webkit-text-stroke:.45px rgba(76,66,56,.32)}.wf-hl{font-style:normal;padding:0 6px;border-radius:6px;white-space:nowrap;background-image:linear-gradient(115deg,#f4c7b6bf,#f7debed9);background-size:100% 42%;background-position:0 82%;background-repeat:no-repeat}.wf-hl.mint{background-image:linear-gradient(115deg,#c6e4d2d9,#e2eed3e6)}.wf-sub{position:relative;margin:26px auto 0;max-width:580px;color:var(--d-ink-soft);font-size:15px;line-height:2.1;letter-spacing:.5px}.wf-dust{position:absolute;top:0;right:0;bottom:0;left:0;pointer-events:none}.wf-dust i{position:absolute;width:6px;height:6px;border-radius:50%;background:radial-gradient(circle,#ffd6aaf2,#ffd6aa00);opacity:0;animation:wf-rise-dust 9s ease-in-out infinite}.wf-dust i:nth-child(1){left:16%;bottom:10%;animation-delay:0s}.wf-dust i:nth-child(2){left:31%;bottom:2%;animation-delay:1.6s;width:4px;height:4px}.wf-dust i:nth-child(3){left:52%;bottom:12%;animation-delay:3.2s}.wf-dust i:nth-child(4){left:67%;bottom:4%;animation-delay:4.8s;width:5px;height:5px}.wf-dust i:nth-child(5){left:80%;bottom:14%;animation-delay:2.4s;width:4px;height:4px}.wf-dust i:nth-child(6){left:44%;bottom:0;animation-delay:6.2s;width:3px;height:3px}@keyframes wf-rise-dust{0%{transform:translateY(0) scale(1);opacity:0}12%{opacity:.7}70%{opacity:.4}to{transform:translateY(-130px) scale(.4);opacity:0}}.wf-section{padding-top:26px}.wf-section-head{display:flex;align-items:baseline;gap:14px;margin:22px 0 18px}.wf-section-title{display:flex;align-items:center;gap:12px;margin:0;font-family:var(--d-serif);font-size:21px;font-weight:700;letter-spacing:3px;color:var(--d-ink)}.wf-section-title:before{content:"";width:22px;height:3px;border-radius:3px;background:linear-gradient(90deg,var(--d-rose),var(--d-amber))}.wf-section-note{font-size:13px;color:var(--d-muted);letter-spacing:1px}.wf-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:22px}.wf-card{--c1: #f0c4b2;--c2: #f7e3cd;--ink: #a2603f;position:relative;display:flex;flex-direction:column;gap:14px;padding:24px 24px 20px;border-radius:22px;background:linear-gradient(180deg,#ffffffeb,#ffffffbd);border:1px solid rgba(255,255,255,.95);box-shadow:0 10px 30px #9676621a,0 2px 8px #9676620f;overflow:hidden;transition:transform .35s cubic-bezier(.22,.9,.32,1),box-shadow .35s ease}.wf-card:before{content:"";position:absolute;top:0;right:0;bottom:0;left:0;background:radial-gradient(190px 140px at 88% -12%,var(--c1),transparent 70%),linear-gradient(180deg,var(--c2),transparent 46%);opacity:.55;transition:opacity .35s ease}.wf-card:after{content:"";position:absolute;left:10%;right:10%;bottom:-44px;height:84px;background:var(--c1);filter:blur(38px);opacity:0;transition:opacity .4s ease;pointer-events:none}.wf-card:hover{transform:translateY(-6px);box-shadow:0 18px 44px #96766229,0 4px 12px #96766214}.wf-card:hover:before{opacity:.8}.wf-card:hover:after{opacity:.32}.wf-badge{position:relative;z-index:1;width:58px;height:58px;border-radius:19px;display:flex;align-items:center;justify-content:center;font-family:var(--d-kai);font-size:28px;font-weight:700;color:var(--ink);background:linear-gradient(140deg,var(--c1),var(--c2));box-shadow:inset 0 0 0 2.5px #ffffffa6,0 8px 18px #9676622e;transition:transform .35s cubic-bezier(.22,.9,.32,1)}.wf-card:hover .wf-badge{transform:translateY(-3px) rotate(-4deg) scale(1.05)}.wf-card-text{position:relative;z-index:1;display:flex;flex-direction:column;gap:9px;align-items:flex-start}.wf-card-title{font-size:19px;font-weight:700;letter-spacing:1.5px;color:var(--d-ink)}.wf-poem{font-family:var(--d-kai);font-size:15px;letter-spacing:1px;color:var(--ink)}.wf-mod{font-size:12px;letter-spacing:.5px;color:var(--d-ink-soft);padding:3px 11px;border-radius:999px;background:#ffffffad;border:1px solid var(--d-line)}.wf-desc{margin:2px 0 0;font-size:13px;line-height:1.95;color:var(--d-ink-soft)}.wf-tags{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:8px;margin-top:auto}.wf-tag{font-size:11px;letter-spacing:1px;color:var(--d-ink-soft);padding:4px 11px;border-radius:999px;background:#ffffffb3;border:1px solid var(--d-line)}.wf-enter{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;width:100%;margin-top:6px;padding-top:13px;border-top:1px dashed var(--d-line);font-size:13px;font-weight:600;letter-spacing:1px;color:var(--ink)}.wf-arrow{font-style:normal;transition:transform .25s ease}.wf-card:hover .wf-arrow{transform:translate(4px)}.wf-community{position:relative;display:flex;align-items:center;justify-content:space-between;gap:28px;padding:30px 34px;border-radius:24px;background:linear-gradient(120deg,#fff4ebeb,#f0f6eeeb,#eef1faeb);border:1px solid rgba(255,255,255,.95);box-shadow:0 10px 30px #9676621a;overflow:hidden}.wf-community:before{content:"";position:absolute;right:-60px;top:-60px;width:210px;height:210px;border-radius:50%;background:radial-gradient(circle,rgba(246,197,180,.55),transparent 70%)}.wf-community:after{content:"";position:absolute;left:-50px;bottom:-70px;width:190px;height:190px;border-radius:50%;background:radial-gradient(circle,rgba(206,215,241,.5),transparent 70%)}.wf-community-text{position:relative;z-index:1}.wf-community-title{margin:0 0 10px;font-family:var(--d-serif);font-size:20px;font-weight:700;letter-spacing:2px;color:var(--d-ink)}.wf-community-desc{margin:0;font-size:13.5px;line-height:2;color:var(--d-ink-soft);max-width:560px}.wf-btn{position:relative;z-index:1;display:inline-flex;align-items:center;gap:9px;padding:13px 28px;border-radius:999px;background:linear-gradient(120deg,#d68e94,#d9a26c);color:#fff;font-weight:600;font-size:14px;letter-spacing:2px;text-shadow:0 1px 1px rgba(140,70,50,.28);white-space:nowrap;box-shadow:0 10px 24px #d6969461,inset 0 1px #ffffff59;transition:transform .25s ease,box-shadow .25s ease}.wf-btn:hover{transform:translateY(-2px);box-shadow:0 14px 30px #d696947a,inset 0 1px #ffffff59}.wf-btn:hover .wf-arrow{transform:translate(4px)}.wf-footer{display:flex;align-items:center;justify-content:center;gap:14px;padding:48px 0 6px;color:var(--d-muted);font-size:12px;letter-spacing:2px}.wf-footer:before,.wf-footer:after{content:"";height:1px;width:60px}.wf-footer:before{background:linear-gradient(90deg,transparent,var(--d-line))}.wf-footer:after{background:linear-gradient(90deg,var(--d-line),transparent)}.wf-footer-brand,.wf-footer-motto{white-space:nowrap}.wf-footer-sep{color:var(--d-muted)}@keyframes wf-rise{0%{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}.wf-eyebrow{animation:wf-rise .7s .05s cubic-bezier(.22,.9,.3,1) backwards}.wf-line{animation:wf-rise .8s .18s cubic-bezier(.22,.9,.3,1) backwards}.wf-sub{animation:wf-rise .8s .34s cubic-bezier(.22,.9,.3,1) backwards}.wf-grid .wf-card{animation:wf-rise .75s cubic-bezier(.22,.9,.3,1) backwards}.wf-grid .wf-card:nth-child(1){animation-delay:.42s}.wf-grid .wf-card:nth-child(2){animation-delay:.54s}.wf-grid .wf-card:nth-child(3){animation-delay:.66s}.wf-community{animation:wf-rise .8s .78s cubic-bezier(.22,.9,.3,1) backwards}.wf-footer{animation:wf-rise .8s .9s cubic-bezier(.22,.9,.3,1) backwards}@media (max-width: 700px){.wf-demos .topbar{flex-direction:column;align-items:flex-start;gap:10px;padding:13px 18px}.wf-demos .nav{width:100%;display:flex;flex-wrap:wrap;gap:8px 18px}.wf-demos .nav a{margin-left:0}.wf-body{padding:0 18px 30px}.wf-hero{padding-top:44px}.wf-line{line-height:2}.wf-sub .wf-br{display:none}.wf-grid{grid-template-columns:1fr}.wf-community{flex-direction:column;align-items:flex-start;padding:24px 22px}.wf-community-desc{max-width:none}.wf-footer{flex-direction:column;gap:6px;letter-spacing:1.5px}.wf-footer:before,.wf-footer:after{display:none}.wf-footer-sep{display:none}}@media (prefers-reduced-motion: reduce){.wf-demos *,.wf-demos *:before,.wf-demos *:after{animation:none!important;transition:none!important}}.wf-combine,.wf-community-page{--d-bg: #fbf7f1;--d-ink: #4c4238;--d-ink-soft: #6d6156;--d-muted: #9c8f81;--d-line: rgba(140, 116, 95, .16);--d-rose: #d98e96;--d-rose-deep: #b96e78;--d-amber: #d8a76a;--d-serif: "Songti SC", "STSong", "SimSun", "Source Han Serif SC", "Noto Serif SC", serif;--d-kai: "Kaiti SC", "STKaiti", "KaiTi", "Songti SC", "SimSun", serif;--bg: #fbf7f1;--panel: #ffffff;--text: #4c4238;--muted: #9c8f81;--accent: #c9838c;--accent2: #7d9bbf;min-height:100vh;background:var(--d-bg);color:var(--d-ink);position:relative;overflow-x:clip;font-family:PingFang SC,Microsoft YaHei,system-ui,sans-serif;-webkit-font-smoothing:antialiased}.wf-combine ::selection,.wf-community-page ::selection{background:#f0c4b2b3;color:#6b4a3a}.wf-combine:before,.wf-community-page:before{content:"";position:fixed;top:0;right:0;bottom:0;left:0;pointer-events:none;background:radial-gradient(640px 440px at 6% -4%,rgba(246,200,180,.34),transparent 66%),radial-gradient(560px 430px at 97% 14%,rgba(197,226,211,.38),transparent 66%),radial-gradient(720px 540px at 52% 116%,rgba(206,215,241,.4),transparent 66%)}.wf-combine .topbar,.wf-community-page .topbar{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;padding:15px 30px;border-bottom:1px solid var(--d-line);background:#fbf7f1cc;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}.wf-combine .brand,.wf-community-page .brand{font-weight:700;letter-spacing:2px;color:var(--d-ink);font-size:15px}.wf-combine .brand .glow,.wf-community-page .brand .glow{margin-left:6px;font-size:13px;font-weight:600;letter-spacing:1px;text-shadow:none;background:linear-gradient(120deg,var(--d-rose-deep),var(--d-amber));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:var(--d-rose-deep)}.wf-combine .nav a,.wf-community-page .nav a{position:relative;margin-left:24px;font-size:14px;letter-spacing:1px;color:var(--d-muted);transition:color .2s ease}.wf-combine .nav a:after,.wf-community-page .nav a:after{content:"";position:absolute;left:0;right:100%;bottom:-6px;height:2px;border-radius:2px;background:linear-gradient(90deg,var(--d-rose),var(--d-amber));transition:right .28s ease}.wf-combine .nav a:hover,.wf-community-page .nav a:hover{color:var(--d-ink)}.wf-combine .nav a:hover:after,.wf-community-page .nav a:hover:after{right:0}.wf-combine .nav a.active,.wf-community-page .nav a.active{color:var(--d-rose-deep);font-weight:600}.wf-combine .nav a.active:after,.wf-community-page .nav a.active:after{right:0}.wf-combine .wf-hero,.wf-community-page .wf-hero{padding:48px 0 26px}.wf-combine .wf-line,.wf-community-page .wf-line{font-size:clamp(22px,3.2vw,34px);letter-spacing:1.5px;margin-top:22px}.wf-combine .section-label,.wf-community-page .section-label{display:flex;align-items:center;gap:9px;color:var(--d-ink);font-size:14px;font-weight:700;letter-spacing:2px;margin:26px 0 12px}.wf-combine .section-label:before,.wf-community-page .section-label:before{content:"";width:14px;height:3px;border-radius:3px;background:linear-gradient(90deg,var(--d-rose),var(--d-amber))}.wf-combine .card,.wf-community-page .card{background:linear-gradient(180deg,#fffffff0,#ffffffc7);border:1px solid rgba(255,255,255,.95);border-radius:18px;box-shadow:0 6px 20px #96766214;animation:wf-rise .6s .35s cubic-bezier(.22,.9,.3,1) backwards}.wf-combine .grid3 .card{transition:transform .3s cubic-bezier(.22,.9,.32,1),box-shadow .3s ease,border-color .3s ease}.wf-combine .grid3 .card:hover{transform:translateY(-4px);box-shadow:0 14px 32px #96766224}.wf-combine .card.selected{border-color:#c98a7880;box-shadow:0 10px 26px #96766224,0 0 0 1px #e0a87833;background:linear-gradient(180deg,#fffdf9,#fdf4ec)}.wf-combine .cat-daily .card.selected{border-color:#e0a878a6;background:linear-gradient(180deg,#fffdf8,#fdf3e7)}.wf-combine .cat-hardware .card.selected{border-color:#7fae97a6;background:linear-gradient(180deg,#fdfffb,#eef7f0)}.wf-combine .cat-ai .card.selected{border-color:#8ba3cca6;background:linear-gradient(180deg,#fbfcff,#eef1f9)}.wf-combine .chip,.wf-community-page .chip{background:#ffffffb8;border:1px solid var(--d-line);color:var(--d-ink-soft)}.wf-combine .chip:hover,.wf-community-page .chip:hover{background:#fffffff2}.wf-community-page .status-chip{background:#d8a76a24;border-color:#d8a76a66;color:#a67c3f}.wf-community-page .chip[data-type=加模组]{background:#7fae9724;border-color:#7fae9773;color:#4f7d66}.wf-community-page .chip[data-type="改 3D 图纸"]{background:#8ba3cc24;border-color:#8ba3cc80;color:#5d6ba0}.wf-community-page .chip[data-type=提方案]{background:#e0a87829;border-color:#e0a87880;color:#a2603f}.wf-community-page .chip[data-type=供物料]{background:#d98e9624;border-color:#d98e9673;color:#b96e78}.wf-combine .category-tabs{display:flex;gap:6px;margin:26px 0 8px;border-bottom:1px solid rgba(140,116,95,.14)}.wf-combine .category-tab{position:relative;background:transparent;border:0;border-bottom:2px solid transparent;padding:12px 16px;cursor:pointer;font:inherit;font-size:14px;letter-spacing:1.5px;color:var(--d-muted);transition:color .2s ease}.wf-combine .category-tab:hover{color:var(--d-ink)}.wf-combine .category-tab span{display:inline-flex;min-width:20px;justify-content:center;margin-left:7px;padding:2px 7px;border-radius:999px;background:#8c745f1a;font-size:11px;color:var(--d-ink-soft);transition:background .2s ease,color .2s ease}.wf-combine .category-tab.active{color:#a2603f;border-bottom-color:#e0a878;font-weight:600}.wf-combine .category-tab.active span{background:#e0a87833;color:#a2603f}.wf-combine .category-tab:nth-child(2).active{color:#4f7d66;border-bottom-color:#7fae97}.wf-combine .category-tab:nth-child(2).active span{background:#7fae9733;color:#4f7d66}.wf-combine .category-tab:nth-child(3).active{color:#5d6ba0;border-bottom-color:#8ba3cc}.wf-combine .category-tab:nth-child(3).active span{background:#8ba3cc33;color:#5d6ba0}.wf-combine .history-panel{margin:30px 0 8px;padding:20px 22px;background:#ffffffbf;border:1px solid rgba(255,255,255,.95);border-radius:20px;box-shadow:0 8px 24px #96766214;animation:wf-rise .7s .45s cubic-bezier(.22,.9,.3,1) backwards}.wf-combine .history-panel .section-label{margin:0 0 4px}.wf-combine .history-caption{color:var(--d-muted);font-size:12px}.wf-combine .history-empty{padding:22px 0 6px;color:var(--d-muted);font-size:13px;text-align:center}.wf-combine .history-list{display:grid;gap:10px;margin-top:14px}.wf-combine .history-row{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:12px 14px;background:#fbf7f199;border:1px solid rgba(140,116,95,.12);border-radius:12px;transition:background .25s ease,border-color .25s ease,transform .25s ease}.wf-combine .history-row:hover{background:#fff;border-color:#d98e9659;transform:translateY(-1px)}.wf-combine .history-name{font-weight:700;font-size:13px;color:var(--d-ink)}.wf-combine .history-actions{display:flex;align-items:center;gap:10px;flex:0 0 auto}.wf-combine .text-button,.wf-community-page .text-button{border:0;padding:4px;background:transparent;color:#7d9bbf;cursor:pointer;font:inherit;font-size:12px;transition:color .2s ease}.wf-combine .text-button:hover,.wf-community-page .text-button:hover{color:var(--d-ink)}.wf-combine .text-button.danger,.wf-community-page .text-button.danger{color:#c98a94}.wf-combine .text-button.danger:hover,.wf-community-page .text-button.danger:hover{color:#b96e78}.wf-combine textarea,.wf-combine input[type=text],.wf-community-page textarea,.wf-community-page input[type=text],.wf-community-page select{width:100%;background:#fff;border:1.5px solid rgba(140,116,95,.18);border-radius:12px;color:var(--d-ink);padding:11px 14px;font-size:14px;resize:vertical;box-shadow:inset 0 1px 2px #9676620a;transition:border-color .2s ease,box-shadow .2s ease}.wf-community-page select{width:auto;resize:none;font-size:13.5px;padding:9px 12px}.wf-combine textarea::placeholder,.wf-combine input[type=text]::placeholder,.wf-community-page textarea::placeholder,.wf-community-page input[type=text]::placeholder{color:#b7ac9d}.wf-combine textarea:focus,.wf-combine input[type=text]:focus,.wf-community-page textarea:focus,.wf-community-page input[type=text]:focus,.wf-community-page select:focus{outline:none;border-color:#d98e96;box-shadow:0 0 0 3px #d98e9626}.wf-combine .btn,.wf-community-page .btn{display:inline-flex;align-items:center;gap:8px;padding:12px 26px;border-radius