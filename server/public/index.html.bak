function wfGenPlan(dailyIds,hwIds,aiIds,idea,items){
var dailies=(dailyIds||[]).map(function(id){return items.daily_items.find(function(x){return x.id===id})}).filter(Boolean);
var hws=(hwIds||[]).map(function(id){return items.hardware_parts.find(function(x){return x.id===id})}).filter(Boolean);
var ais=(aiIds||[]).map(function(id){return items.ai_modules.find(function(x){return x.id===id})}).filter(Boolean);
var wk=null;
if(typeof WK_CFG!=="undefined"&&dailyIds.length){wk=WK_CFG.find(function(c){return c.id===dailyIds[0]})}
var baseName=dailies.length?dailies[0].name:"旧物";
var baseDesc=dailies.length?dailies[0].desc:"";
var hwNames=hws.map(function(x){return x.name});
var aiNames=ais.map(function(x){return x.name});
var allMods=hwNames.concat(aiNames);
var modSuffix=allMods.length?" · "+allMods.slice(0,3).join("+"):"";
var name=baseName+modSuffix;
var image_urls=[];
if(wk){
var slug=WK_ROUTE[dailyIds[0]].split("/").pop();
var p0m=hwIds.indexOf(wk.parts[0].id)>=0;
var p1m=wk.parts[1]&&hwIds.indexOf(wk.parts[1].id)>=0;
var shotKey="plain";
if(p0m&&p1m)shotKey="both";
else if(p0m)shotKey=wk.parts[0].key;
else if(p1m)shotKey=wk.parts[1].key;
else if(hws.length>0)shotKey="both";
image_urls=[slug+"/"+slug+"-"+shotKey+".jpg"]
}
var intro="以「"+baseName+"」为基底"+(baseDesc?"（"+baseDesc+"）":"")+",";
if(hws.length&&ais.length){
intro+="搭载"+hwNames.join("与")+"，注入"+aiNames.join("与")+"的 AI 能力——硬件赋予它新的感知与表达，AI 让它学会理解与陪伴，让旧物重新被看见、被听见、被记住。"
}else if(hws.length){
intro+="搭载"+hwNames.join("与")+"，用硬件改造赋予它新的功能与表达，让旧物在新的场景里重新被使用。"
}else if(ais.length){
intro+="注入"+aiNames.join("与")+"的 AI 能力，让旧物学会感知、理解与陪伴，成为日常生活中一个温柔的存在。"
}else{
intro+="保留它本来的质感与故事，让它继续在日常中安静陪伴。"
}
if(idea)intro+="「"+idea+"」";
var play=[];
hws.forEach(function(hw){
if(wk){var wp=wk.parts.find(function(p){return p.id===hw.id});if(wp){play.push(wp.name+" · "+wp.install+"："+wp.effect);return}}
var t=hw.tags||[];var ed;
if(t.indexOf("发光")>=0)ed="为"+baseName+"增添柔和的氛围光效";
else if(t.indexOf("发声")>=0)ed="让"+baseName+"获得更温暖的声线";
else if(t.indexOf("感知")>=0)ed="让"+baseName+"能感知环境变化并自动响应";
else if(t.indexOf("运动")>=0)ed="赋予"+baseName+"自主运动能力";
else if(t.indexOf("显示")>=0)ed="为"+baseName+"增加一块会回放的小窗";
else if(t.indexOf("振动")>=0)ed="让"+baseName+"在触碰时轻轻回应";
else ed="为"+baseName+"增添新的功能可能";
play.push(hw.name+"："+hw.desc+"，"+ed)
});
ais.forEach(function(ai){
if(wk){var wm=wk.mods.find(function(m){return m.id===ai.id});if(wm){play.push(wm.name+" · "+wm.panel+"："+wm.effect);return}}
var t=ai.tags||[];var ed;
if(t.indexOf("声音")>=0)ed="用声音连接人与旧物";
else if(t.indexOf("记忆")>=0)ed="把日常存成值得回看的时间轴";
else if(t.indexOf("陪伴")>=0)ed="在日常里提供温柔的陪伴";
else if(t.indexOf("分身")>=0)ed="让旧物里的人重新开口说话";
else if(t.indexOf("创作")>=0)ed="把旧事变成新的故事";
else if(t.indexOf("情感")>=0)ed="读懂情绪并温柔回应";
else ed="议"+baseName+"开始懂你";
play.push(ai.name+"："+ai.desc+"，"+ed)
});
if(!play.length)play.push("日常把玩："+baseName+"本身的质感与故事，已是最好的陪伴");
play.push("分享与传承：把改造后的"+baseName+"故事讲给下一个人听");
var materials=[];
dailies.forEach(function(d){materials.push("1 件 "+d.name+"（基底物品）")});
hws.forEach(function(h){var ii="";if(wk){var wp=wk.parts.find(function(p){return p.id===h.id});if(wp)ii="（"+wp.install+"）"}materials.push("1 个 "+h.name+"："+h.desc+ii)});
ais.forEach(function(ai){materials.push("1 套 "+ai.name+" AI 模组："+ai.desc)});
var steps=[];
steps.push("准备基底：取一件"+baseName+"，清洁、检查结构完整性");
hws.forEach(function(hw,i){if(wk){var wp=wk.parts.find(function(p){return p.id===hw.id});if(wp){steps.push("安装部件 "+(i+1)+"："+wp.install+"，确保固定牢靠且不影响原有外观");return}}steps.push("安装部件 "+(i+1)+"：将"+hw.name+"嵌入"+baseName+"的合适位置，确保固定牢靠")});
ais.forEach(function(ai,i){if(wk){var wm=wk.mods.find(function(m){return m.id===ai.id});if(wm){steps.push("接入 AI 模组 "+(i+1)+"：配置"+ai.name+"，"+wm.effect);return}}steps.push("接入 AI 模组 "+(i+1)+"：配置"+ai.name+"，连接平台或本地服务，完成能力初始化")});
steps.push("整体联调：通电/启动，测试所有部件与模组的协同效果");
steps.push("打磨细节：调整外观、音效、灯光等细节，让改造痕迹自然融入旧物质感");
steps.push("完成与记录：拍下成品，写下属于这件"+baseName+"的新故事");
return{result:{name:name,intro:intro,play:play,materials:materials,steps:steps},image_urls:image_urls,web_thread_link:null}
}
const WK_ROUTE={"di-01":"/combine/cup","di-02":"/combine/phone","di-51":"/combine/bed","di-03":"/combine/comb","di-04":"/combine/lamp","di-05":"/combine/box","di-06":"/combine/radio","di-07":"/combine/camera","di-08":"/combine/clock","di-10":"/combine/frame","di-11":"/combine/typewriter","di-12":"/combine/kerosene","di-13":"/combine/suitcase","di-14":"/combine/tv","di-15":"/combine/flashlight","di-16":"/combine/sewing","di-17":"/combine/frog","di-18":"/combine/fan","di-19":"/combine/gramophone","di-20":"/combine/watch","di-22":"/combine/cradle","di-23":"/combine/chair","di-33":"/combine/bell","di-50":"/combine/album"};
const WK_CFG=[{"id":"di-03","el":{"name":"檀木梳","desc":"木制齿梳，握感温润，适合嵌装小部件","tags":["日用品","木质","随身"]},"parts":[{"key":"mic","id":"hp-10","name":"电容麦克风","desc":"高灵敏度拾音头","tags":["收音","音频","输入"],"install":"梳柄开槽 · 内嵌拾音头","effect":"梳头时悄悄录下一小段日常，藏在梳柄里"},{"key":"fiber","id":"hp-24","name":"光导纤维","desc":"会漏光的细光纤","tags":["光学","柔性","氛围"],"install":"梳背嵌槽 · 埋入一圈微光光纤","effect":"梳背浮起一圈柔柔的光，像把夜色梳顺了"}],"mods":[{"key":"record","id":"ai-02","name":"声音录制","desc":"持续采集与归档声音","tags":["采集","记录","回忆"],"effect":"把梳头时的哼唱、碎碎念，慢慢存成一条时间轴","panel":"声音留档"},{"key":"playback","id":"ai-10","name":"语音播报","desc":"文字转自然语音","tags":["语音","输出","交互"],"effect":"某天回放，听见那年梳头时的轻声","panel":"回忆回放"}],"shots":{"plain":{"img":"comb/comb-plain.jpg","label":"原设计 · 午后木桌","caption":"还是那把温润的檀木梳，静静躺在妆台上。"},"mic":{"img":"comb/comb-mic.jpg","label":"收音 · 悄悄留档","caption":"梳柄里多了一枚小小的拾音头，把日常轻轻收进时光。"},"fiber":{"img":"comb/comb-fiber.jpg","label":"光纤 · 夜色微光","caption":"梳背一圈柔光，像把夜色也梳得服服帖帖。"},"both":{"img":"comb/comb-both.jpg","label":"全组合 · 会说话的梳子","caption":"边梳边存、夜里发光——一把会记住日常的梳子。"}}},{"id":"di-04","el":{"name":"黄铜台灯","desc":"暖光台灯，金属灯罩","tags":["照明","金属","桌面"]},"parts":[{"key":"light","id":"hp-18","name":"光敏传感器","desc":"感知光线明暗","tags":["感知","光线","自动"],"install":"灯座嵌装 · 面向窗口","effect":"天光一暗，灯就自己亮起来"},{"key":"rgb","id":"hp-36","name":"RGB 全彩灯珠","desc":"千变万色的灯珠","tags":["发光","色彩","氛围"],"install":"灯罩内环 · 替换光源","effect":"暖黄之外，还能调出晚霞般的一抹柔彩"}],"mods":[{"key":"alarm","id":"ai-44","name":"智能闹钟","desc":"被叫醒也温柔","tags":["时间","起居","关怀"],"effect":"天一亮，用最柔的光把你叫醒","panel":"温柔叫醒"},{"key":"lull","id":"ai-33","name":"睡前故事","desc":"轻声讲的哄睡故事","tags":["陪伴","故事","儿童"],"effect":"熄灯后，替你讲一小段睡前故事","panel":"睡前故事"}],"shots":{"plain":{"img":"lamp/lamp-plain.jpg","label":"原设计 · 深夜书桌","caption":"一盏安静的黄铜台灯，陪你读完整本旧书。"},"light":{"img":"lamp/lamp-light.jpg","label":"光敏 · 日落自亮","caption":"天一暗，它就懂你地亮起来，等你回家。"},"rgb":{"img":"lamp/lamp-rgb.jpg","label":"灯珠 · 晚霞暖彩","caption":"灯罩里透出一抹柔和的晚霞色。"},"both":{"img":"lamp/lamp-both.jpg","label":"全组合 · 守夜小灯","caption":"日落自动亮、睡