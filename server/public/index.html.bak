lock;aspect-ratio:4 / 3;object-fit:cover}.cup-thumb span{position:absolute;left:0;right:0;bottom:0;padding:5px 8px;font-size:11px;font-weight:600;color:#fff;background:linear-gradient(180deg,transparent,rgba(60,45,35,.55))}.cup-entry{font-size:12px;font-weight:700;color:var(--accent2);text-decoration:none;padding:3px 10px;border-radius:999px;background:#7d9bbf1f}.cup-entry:hover{background:#7d9bbf33}@media (max-width: 900px){.cup-layout{grid-template-columns:1fr}}.cup-thumbs-wrap{margin-top:16px}.cup-thumbs-label{font-size:12px;color:var(--muted);margin-bottom:8px}.cup-thumbs-wrap .cup-thumbs{margin-top:0}.cup-addon.cup-ai.selected{border-color:#8ba3cca6;background:linear-gradient(180deg,#fbfcff,#eef1f9)}.cup-addon.cup-ai.selected .cup-addon-state{background:#8ba3cc2e;color:#5d6ba0}.cup-views{display:flex;gap:10px;margin-bottom:16px;flex-wrap:wrap}.cup-view{padding:9px 20px;border-radius:999px;border:1.5px solid var(--d-line);background:var(--panel);color:var(--d-ink-soft);font-size:14px;font-weight:600;cursor:pointer;transition:all .25s ease}.cup-view:hover{border-color:#c98a8c73;color:var(--text)}.cup-view.active{background:linear-gradient(135deg,#c9838c,#b96e78);color:#fff;border-color:transparent;box-shadow:0 8px 20px #c98a8c47}.c-panel{background:var(--panel);border:1px solid var(--d-line);border-radius:20px;padding:26px 28px;box-shadow:0 14px 36px #9676621f;min-height:520px}.c-panel-title{font-size:20px;font-weight:700;color:var(--text)}.c-panel-sub{margin:8px 0 0;font-size:13px;color:var(--muted);line-height:1.8}.c-voice-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:16px;margin-top:18px}.c-voice-step{padding:18px 20px;border-radius:14px;background:linear-gradient(180deg,#fffdf8,#fdf4ec);border:1px solid rgba(224,168,120,.35)}.c-step-tag{font-size:12px;font-weight:700;color:var(--accent);letter-spacing:1px;margin-bottom:12px}.c-rec-btn{width:72px;height:72px;border-radius:50%;border:none;background:linear-gradient(135deg,#c9838c,#b96e78);cursor:pointer;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 10px 24px #c98a8c52;transition:transform .2s ease}.c-rec-btn:hover{transform:scale(1.06)}.c-rec-btn.recording{background:linear-gradient(135deg,#d98e96,#b96e78);animation:c-pulse 1.4s infinite}.c-rec-core{width:26px;height:26px;border-radius:50%;background:#fffffff2}.c-rec-core.stop{border-radius:6px;width:22px;height:22px}.c-rec-live{display:flex;align-items:center;gap:16px}.c-timer{font-size:24px;font-weight:700;color:var(--d-rose-deep);font-variant-numeric:tabular-nums}.c-wave{display:block;width:100%;max-width:280px;height:72px;margin-top:12px;border-radius:10px;background:#ffffffb3;border:1px dashed rgba(201,138,140,.35)}.c-upload-link{display:inline-block;margin-top:12px;font-size:13px;font-weight:600;color:var(--accent2);text-decoration:underline;text-underline-offset:3px;cursor:pointer}.c-hidden-input{display:none}.c-voice-hint{margin-top:10px;font-size:12.5px;color:var(--d-amber);line-height:1.7}.c-wait{font-size:13px;color:var(--muted);line-height:1.9;padding:18px 0}.c-voice-audio{display:block;width:100%;margin-bottom:14px}.c-clone-btn{width:100%}.c-clone-progress{height:8px;border-radius:999px;background:#f3ece2;overflow:hidden}.c-clone-bar{height:100%;border-radius:999px;background:linear-gradient(90deg,#c9838c,#b96e78);transition:width .9s ease}.c-stage-text{margin-top:10px;font-size:13px;color:var(--d-ink-soft)}.c-clone-done{padding:4px 0}.c-done-line{font-size:14px;font-weight:700;color:var(--text);margin-bottom:12px}.c-sent-row{display:flex;gap:10px;flex-wrap:wrap}.c-sent{padding:9px 16px;border-radius:999px;border:1px solid rgba(201,138,140,.35);background:#c98a8c14;color:var(--text);font-size:14px;cursor:pointer;transition:background .25s ease}.c-sent:hover{background:#c98a8c29}.c-note{margin:18px 0 0;font-size:12px;color:var(--muted);line-height:1.8;border-top:1px dashed var(--d-line);padding-top:12px}.c-album-up{margin-top:18px;display:grid;grid-template-columns:1fr 1fr;gap:14px}.c-up-btn{display:flex;align-items:center;justify-content:center;gap:10px;padding:22px 14px;border-radius:14px;border:1.5px dashed rgba(139,163,204,.55);background:linear-gradient(180deg,#fbfcff,#f2f5fb);color:var(--d-ink-soft);font-size:14px;font-weight:600;cursor:pointer;transition:all .25s ease}.c-up-btn:hover{border-color:#8ba3cce6;background:linear-gradient(180deg,#f6f8fd,#e9eef7)}.c-up-icon{color:var(--accent2);font-size:15px}.c-album-text{grid-column:1 / -1;display:grid;gap:10px;padding:16px;border-radius:14px;background:linear-gradient(180deg,#fffdf8,#fdf4ec);border:1px solid rgba(224,168,120,.35)}.c-event-input,.c-mem-input{width:100%;border:1px solid var(--d-line);border-radius:10px;padding:10px 12px;font-size:13px;color:var(--text);background:#fff;outline:none;resize:vertical;font-family:inherit}.c-event-input:focus,.c-mem-input:focus{border-color:#c98a8c80}.c-text-save{justify-self:start}.c-mem-grid{margin-top:18px;display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.c-mem{position:relative;border:1px solid var(--d-line);border-radius:14px;overflow:hidden;background:#fff;transition:transform .25s ease,box-shadow .25s ease}.c-mem:hover{transform:translateY(-3px);box-shadow:0 10px 26px #96766224}.c-mem-media{display:block;width:100%;aspect-ratio:4 / 3;object-fit:cover;background:#f3ece2}.c-mem-text{padding:16px;font-size:13px;line-height:1.9;color:var(--d-ink-soft);background:linear-gradient(180deg,#fffdf8,#fdf4ec);min-height:90px}.c-mem-body{padding:10px 12px}.c-mem-title{font-size:13px;font-weight:700;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.c-mem-meta{display:flex;align-items:center;gap:8px;margin-top:6px;flex-wrap:wrap}.c-mem-kind{font-size:11px;padding:2px 8px;border-radius:999px;background:#d8a76a24;color:#9c6f3f}.c-mem-time{font-size:11px;color:var(--muted)}.c-badge{font-size:11px;padding:3px 9px;border-radius:999px}.c-badge.learned{background:#7fae9729;color:#4f7d66}.c-badge.learning{background:#d8a76a29;color:#9c6f3f;animation:c-breath 1.2s infinite}.c-mem-del{position:absolute;top:8px;right:8px;width:26px;height:26px;border-radius:50%;border:none;background:#4c423873;color:#fff;font-size:12px;cursor:pointer;opacity:0;transition:opacity .2s ease}.c-mem:hover .c-mem-del{opacity:1}.c-mem-empty{margin-top:18px;padding:26px;border-radius:14px;border:1.5px dashed var(--d-line);text-align:center;font-size:13px;color:var(--muted);line-height:1.8}@keyframes c-pulse{0%{box-shadow:0 0 #b96e7859}50%{box-shadow:0 0 0 14px #b96e7800}to{box-shadow:0 0 #b96e7800}}@keyframes c-breath{0%,to{opacity:.55}50%{opacity:1}}@media (max-width: 900px){.c-voice-grid{grid-template-columns:1fr}.c-mem-grid{grid-template-columns:repeat(2,1fr)}.c-album-up{grid-template-columns:1fr}}.cup-stage-3d{position:relative;border-radius:20px;overflow:hidden;border:1px solid var(--d-line);box-shadow:0 18px 44px #9676622e;background:#2a241e}.cup-stage-3d canvas{display:block;width:100%;aspect-ratio:4 / 3;touch-action:none;cursor:grab}.cup-stage-3d canvas:active{cursor:grabbing}.phone-ops{display:flex;gap:16px;flex-wrap:wrap;justify-content:center;margin:14px 6px 0;font-size:12.5px;color:var(--muted)}.phone-ops span:before{content:"·";margin-right:6px;color:var(--accent)}.phone-logs{display:flex;flex-direction:column;gap:6px;margin:14px 6px 0}.phone-log{font-size:12.5px;color:var(--d-ink-soft);background:#fffdf8b8;border:1px solid var(--d-line);border-radius:999px;padding:6px 14px;width:fit-content;animation:c-breath 1.6s ease}.phone-log:first-child{border-color:#c98a8c66;color:var(--text)}.wf-demo{--d-bg: #f6efe2;--d-ink: #4a3f33;--d-ink-soft: #6e6152;--d-muted: #a2937f;--d-line: rgba(150, 122, 82, .18);--d-rose: #d98e96;--d-rose-deep: #b96e78;--d-amber: #d8a76a;--d-serif: "Songti SC", "STSong", "SimSun", "Source Han Serif SC", "Noto Serif SC", serif;--d-kai: "Kaiti SC", "STKaiti", "KaiTi", "Songti SC", "SimSun", serif;--bg: #f6efe2;--panel: #ffffff;--text: #4a3f33;--muted: #a2937f;--accent: #c9838c;--accent2: #7d9bbf;min-height:100vh;color:var(--d-ink);position:relative;overflow-x:clip;font-family:PingFang SC,Microsoft YaHei,system-ui,sans-serif;-webkit-font-smoothing:antialiased;background:repeating-linear-gradient(0deg,rgba(146,120,86,.026) 0 1px,transparent 1px 4px),var(--d-bg)}.wf-demo ::selection{background:#ecc8aabf;color:#6b4a34}.wf-demo:before{content:"";position:fixed;top:0;right:0;bottom:0;left:0;pointer-events:none;background:radial-gradient(620px 420px at 5% -6%,rgba(238,205,176,.36),transparent 66%),radial-gradient(520px 400px at 97% 18%,rgba(206,220,197,.3),transparent 66%),radial-gradient(700px 500px at 55% 118%,rgba(209,209,228,.3),transparent 66%)}.wf-demo .topbar{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;padding:15px 30px;border-bottom:1px solid var(--d-line);background:#f6efe2d1;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}.wf-demo .brand{font-weight:700;letter-spacing:2px;color:var(--d-ink);font-size:15px}.wf-demo .brand .glow{margin-left:6px;font-size:13px;font-weight:600;letter-spacing:1px;text-shadow:none;background:linear-gradient(120deg,var(--d-rose-deep),var(--d-amber));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:var(--d-rose-deep)}.wf-demo .nav a{position:relative;margin-left:24px;font-size:14px;letter-spacing:1px;color:var(--d-muted);transition:color .2s ease}.wf-demo .nav a:after{content:"";position:absolute;left:0;right:100%;bottom:-6px;height:2px;border-radius:2px;background:linear-gradient(90deg,var(--d-rose),var(--d-amber));transition:right .28s ease}.wf-demo .nav a:hover{color:var(--d-ink)}.wf-demo .nav a:hover:after{right:0}.wf-demo .nav a.active{color:var(--d-rose-deep);font-weight:600}.wf-demo .nav a.active:after{right:0}.wf-demo-top{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:22px;animation:wf-rise .6s .05s cubic-bezier(.22,.9,.3,1) backwards}.wf-back{font-size:13px;color:var(--d-muted);letter-spacing:1px;transition:color .2s ease}.wf-back:hover{color:var(--d-rose-deep)}.wf-archive-no{font-size:12px;letter-spacing:3px;color:var(--ink, #a2603f);padding:5px 15px;border:1px dashed var(--c1, #e8bfa8);border-radius:999px;background:#fff9;white-space:nowrap}.wf-demo-hero{position:relative;z-index:1;text-align:center;padding:30px 0 24px}.wf-demo-title{margin:0;font-family:var(--d-serif);font-size:clamp(26px,3.6vw,36px);font-weight:700;letter-spacing:3px;line-height:1.6;color:var(--d-ink);-webkit-text-stroke:.45px rgba(74,63,51,.3);animation:wf-rise .7s .12s cubic-bezier(.22,.9,.3,1) backwards}.wf-demo-poem{margin:14px 0 0;font-family:var(--d-kai);font-size:17px;letter-spacing:1.5px;color:var(--ink, #a2603f);animation:wf-rise .7s .24s cubic-bezier(.22,.9,.3,1) backwards}.wf-stage{position:relative;z-index:1;padding:12px;border-radius:24px;background:linear-gradient(165deg,#fdf8ee,#f0e4cd);border:1px solid rgba(255,255,255,.85);box-shadow:0 18px 44px #8c6c4229,inset 0 0 0 1px #d6b27a33;animation:wf-rise .75s .34s cubic-bezier(.22,.9,.3,1) backwards}.wf-stage canvas{display:block;width:100%;height:460px;border-radius:15px;background:#1c130b}.wf-stage:before,.wf-stage:after{content:"";position:absolute;top:-13px;width:94px;height:27px;border-radius:4px;background:linear-gradient(180deg,#ffffff4d,#fff0 55%),var(--c1, #e8bfa8);opacity:.8;box-shadow:0 2px 6px #785a3233;pointer-events:none}.wf-stage:before{left:48px;transform:rotate(-5deg)}.wf-stage:after{right:48px;transform:rotate(4deg);background:linear-gradient(180deg,#ffffff4d,#fff0 55%),var(--c2, #f2d9b8);opacity:.72}.wf-logs{position:absolute;left:24px;top:26px;display:flex;flex-direction:column;gap:5px;max-width:300px;pointer-events:none}.wf-log{font-size:12px;letter-spacing:.5px;color:#f0e2ca;background:#1e140a9e;border:1px solid rgba(255,214,160,.14);padding:5px 11px;border-radius:9px;-webkit-backdrop-filter:blur(5px);backdrop-filter:blur(5px);animation:wf-rise .5s cubic-bezier(.22,.9,.3,1) backwards}.wf-log:first-child{color:#ffd9a0;border-color:#ffd9a059}.wf-note{position:relative;z-index:1;margin-top:30px;padding:26px 30px 22px;border-radius:18px;background:repeating-linear-gradient(0deg,rgba(150,122,82,.04) 0 1px,transparent 1px 27px),linear-gradient(180deg,#fffdf4,#fdf5e4);border:1px solid rgba(255,255,255,.92);box-shadow:0 10px 26px #8c6c421a;animation:wf-rise .75s .46s cubic-bezier(.22,.9,.3,1) backwards}.wf-note:before{content:"";position:absolute;top:-13px;left:50%;width:110px;height:27px;margin-left:-55px;border-radius:4px;transform:rotate(-2deg);background:linear-gradient(180deg,#ffffff4d,#fff0 55%),var(--c1, #e8bfa8);opacity:.78;box-shadow:0 2px 6px #785a322e}.wf-note-label{font-size:11px;letter-spacing:4px;color:var(--d-muted);margin-bottom:12px}.wf-note-text{margin:0;font-family:var(--d-kai);font-size:15.5px;line-height:2.2;letter-spacing:.5px;color:#5a4c3c;text-indent:2em}.wf-note-tags{margin-top:16px;display:flex;flex-wrap:wrap;gap:8px}.wf-note-tag{font-size:11px;letter-spacing:1px;color:var(--d-ink-soft);padding:4px 12px;border-radius:999px;background:#ffffffb8;border:1px solid var(--d-line)}.wf-hints{position:relative;z-index:1;margin-top:20px;display:flex;flex-wrap:wrap;gap:10px 22px;justify-content:center;animation:wf-rise .75s .58s cubic-bezier(.22,.9,.3,1) backwards}.wf-hint{display:inline-flex;align-items:center;gap:9px;font-size:13px;letter-spacing:.5px;color:var(--d-ink-soft)}.wf-hint i{font-style:normal;flex:0 0 auto;width:22px;height:22px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#fff;background:linear-gradient(135deg,var(--c1, #e8bfa8),var(--c2, #f2d9b8));box-shadow:inset 0 0 0 2px #ffffff73,0 4px 10px #8c6c4238}@media (max-width: 700px){.wf-demo .topbar{flex-direction:column;align-items:flex-start;gap:10px;padding:13px 18px}.wf-demo .nav{width:100%;display:flex;flex-wrap:wrap;gap:8px 18px}.wf-demo .nav a{margin-left:0}.wf-demo .wf-body{padding:0 18px 30px}.wf-demo-top{padding-top:18px}.wf-demo-hero{padding:22px 0 20px}.wf-stage{padding:9px;border-radius:18px}.wf-stage canvas{height:340px;border-radius:11px}.wf-stage:before,.wf-stage:after{width:70px;top:-11px}.wf-stage:before{left:26px}.wf-stage:after{right:26px}.wf-logs{left:18px;top:20px;max-width:220px}.wf-note{margin-top:24px;padding:22px 20px 18px}.wf-note-text{font-size:14.5px}.wf-hints{gap:8px 14px}}@media (prefers-reduced-motion: reduce){.wf-demo *,.wf-demo *:before,.wf-demo *:after{animation:none!important;transition:none!important}}:root{--bg: #0b0d12;--panel: #141823;--accent: #f5b45a;--accent2: #7ec8ff;--text: #e8e6df;--muted: #8d93a3}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:PingFang SC,Microsoft YaHei,system-ui,sans-serif}a{color:inherit;text-decoration:none}.topbar{display:flex;align-items:center;justify-content:space-between;padding:14px 28px;border-bottom:1px solid rgba(255,255,255,.06)}.brand{font-weight:700;letter-spacing:1px}.brand .glow{color:var(--accent);text-shadow:0 0 14px rgba(245,180,90,.55)}.nav a{margin-left:18px;color:var(--muted);transition:color .15s}.nav a:hover,.nav a.active{color:var(--text)}.page{padding:24px 28px;max-width:1100px;margin:0 auto}h1.title{font-size:22px;margin:0 0 6px}.subtitle{color:var(--muted);margin:0 0 20px;font-size:14px}.card{background:var(--panel);border:1px solid rgba(255,255,255,.07);border-radius:14px;padding:18px}.grid3{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px;margin-top:18px}.chip{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:999px;background:#ffffff0d;border:1px solid rgba(255,255,255,.1);cursor:pointer;-webkit-user-select:none;user-select:none;font-size:13px;transition:all .15s}.chip:hover{background:#ffffff1a}.chip.selected{background:#f5b45a26;border-color:var(--accent);color:#ffd9a0}.chip .tag{color:var(--muted);font-size:11px}.category-tabs{display:flex;gap:8px;margin:20px 0 2px;border-bottom:1px solid rgba(255,255,255,.08)}.category-tab{background:transparent;color:var(--muted);border:0;border-bottom:2px solid transparent;padding:11px 14px;cursor:pointer;font:inherit}.category-tab span{display:inline-flex;min-width:20px;justify-content:center;margin-left:7px;padding:2px 6px;border-radius:999px;background:#ffffff14;font-size:11px}.category-tab.active{color:var(--accent);border-bottom-color:var(--accent)}.category-tab.active span{background:#f5b45a29}.selected-summary{color:var(--muted);font-size:12px;line-height:1.6}.history-panel{margin:22px 0 8px;padding:16px 18px;background:#141823b8;border:1px solid rgba(255,255,255,.08);border-radius:12px}.history-heading{display:flex;align-items:center;justify-content:space-between;gap:16px}.history-heading .section-label{margin:0 0 4px}.history-caption,.history-empty,.history-date{color:var(--muted);font-size:12px}.history-empty{padding:14px 0 2px}.history-list{display:grid;gap:8px;margin-top:12px}.history-row{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:11px 12px;background:#ffffff09;border:1px solid rgba(255,255,255,.06);border-radius:9px}.history-row-main{min-width:0}.history-name{font-weight:700;font-size:13px}.history-items{margin-top:3px;color:var(--muted);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.history-date{margin-top:4px;font-size:11px}.history-actions{display:flex;align-items:center;gap:10px;flex:0 0 auto}.text-button{border:0;padding:4px;background:transparent;color:var(--accent2);cursor:pointer;font:inherit;font-size:12px}.text-button:hover{color:var(--text)}.text-button.danger{color:#f28d8d}.btn.compact{padding:7px 12px;font-size:12px}.btn{display:inline-flex;align-items:center;gap:8px;padding:11px 22px;border-radius:10px;border:1px solid transparent;background:var(--accent);color:#17130b;font-weight:700;font-size:14px;cursor:pointer;transition:all .15s}.btn:hover{filter:brightness(1.08)}.btn:disabled{opacity:.45;cursor:not-allowed}.btn.ghost{background:transparent;border-color:#ffffff2e;color:var(--text)}.result-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.media-box{position:relative;border-radius:12px;overflow:hidden;background:#05070a;min-height:280px;display:flex;align-items:center;justify-content:center}.media-box img{max-width:100%;max-height:420px;display:block}.video-slot{margin-top:10px;min-height:58px;display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:10px;background:#0000008c;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);font-size:12px;color:var(--muted);border:1px dashed rgba(255,255,255,.25)}.video-slot .play-btn{flex:0 0 auto}.play-btn{width:30px;height:30px;border-radius:50%;background:var(--accent2);color:#06233a;display:inline-flex;align-items:center;justify-content:center;font-weight:900;cursor:pointer}.section-label{color:var(--muted);font-size:12px;text-transform:uppercase;letter-spacing:1px;margin:20px 0 10px}.skeleton{min-height:280px;border-radius:12px;background:linear-gradient(100deg,#10141d 40%,#1a2030,#10141d 60%);background-size:200% 100%;animation:shimmer 1.4s infinite}@keyframes shimmer{to{background-position:-200% 0}}textarea,input[type=text]{width:100%;background:#0d1017;border:1px solid rgba(255,255,255,.12);border-radius:10px;color:var(--text);padding:10px 12px;font-size:14px;resize:vertical}textarea:focus,input[type=text]:focus{outline:none;border-color:var(--accent)}.error-box{margin-top:14px;padding:12px 14px;border-radius:10px;background:#ff5a5a1f;border:1px solid rgba(255,90,90,.4);color:#ffb4b4;font-size:13px}.spin{display:inline-block;width:14px;height:14px;border:2px solid rgba(0,0,0,.25);border-top-color:#17130b;border-radius:50%;animation:rot .7s linear infinite}@keyframes rot{to{transform:rotate(360deg)}}@media (max-width: 700px){.topbar{padding:13px 16px;align-items:flex-start;gap:10px;flex-direction:column}.brand{font-size:13px}.nav{width:100%;display:flex;flex-wrap:wrap;justify-content:flex-start;gap:8px 16px}.nav a{margin-left:0;font-size:12px}.page{padding:20px 16px}.result-grid,.grid3{grid-template-columns:1fr}.selected-summary{margin-top:4px}.btn{padding:10px 15px}.history-row{align-items:flex-start}.history-actions{flex-direction:column;align-items:flex-end;gap:4px}}

</style>
</head>
<body>
